# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment / secrets
.env
.env.*
*.secret

# Byte-compiled / cache
*.egg-info/
dist/
build/
.eggs/
*.egg

